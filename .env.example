# UnifiedAiClient — Environment Variables Reference
#
# These are the environment variables read by load_secrets().
# Set them in your shell, Docker environment, CI/CD secrets, etc.
#
# NOTE: This is a reference, NOT a file parsed by the library.
#       The library reads from os.environ, not from a .env file.
#       Use a tool like direnv, Docker --env-file, or your CI/CD
#       provider's secret injection to populate these before running.
#
# Server URLs for local providers (Ollama, LM Studio, llama.cpp) are
# NOT environment variables — set them in config.json instead.

# ---------------------------------------------------------------------------
# Cloud provider API keys
# ---------------------------------------------------------------------------

# Google AI (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
