{
    "_comment": "Reference of built-in provider defaults. The preferred way to configure providers is now configure_provider() in code (see README). This file is still read as a fallback if configure_provider() was never called for a given provider. Keys: 'url', 'timeout', 'sleep_time' map to ProviderConfig fields; all other keys are collected into extra_options and forwarded as provider-specific settings (e.g. context_size → num_ctx in Ollama, max_tokens → num_predict/max_output_tokens).",

    "ollama": {
        "url": "http://localhost:11434",
        "timeout": 300,
        "keep_alive": "15m",
        "context_size": 0,
        "top_k": 64,
        "top_p": 0.95
    },

    "google": {
        "sleep_time": 3,
        "disable_safety": false,
        "timeout": 30,
        "upload_poll_timeout": 15
    },

    "openai": {
        "url": "https://api.openai.com",
        "timeout": 300,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "anthropic": {
        "url": "https://api.anthropic.com",
        "timeout": 300,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "lmstudio": {
        "url": "http://localhost:1234",
        "timeout": 300,
        "context_size": 0
    },

    "llamacpp": {
        "url": "http://localhost:8080",
        "timeout": 300,
        "context_size": 0
    },

    "mistral": {
        "url": "https://api.mistral.ai",
        "timeout": 300,
        "sleep_time": 0
    },

    "cohere": {
        "url": "https://api.cohere.ai/compatibility",
        "timeout": 300,
        "sleep_time": 0
    },

    "meta": {
        "url": "https://api.llama-api.com",
        "timeout": 300,
