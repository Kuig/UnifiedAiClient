{
    "_comment": "Copy this file to config.json. All keys except 'url', 'timeout', and 'sleep_time' are dynamically loaded into the provider's 'extra_options'. You can specify custom provider-specific keys or universal sampling defaults (like 'top_k', 'top_p', 'max_tokens') here.",

    "ollama": {
        "url": "http://localhost:11434",
        "timeout": 120,
        "keep_alive": "15m",
        "context_size": 0,
        "top_k": 64,
        "top_p": 0.95
    },

    "google": {
        "sleep_time": 3,
        "disable_safety": false,
        "timeout": 30,
        "upload_poll_timeout": 15
    },

    "openai": {
        "url": "https://api.openai.com",
        "timeout": 120,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "anthropic": {
        "url": "https://api.anthropic.com",
        "timeout": 120,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "lmstudio": {
        "url": "http://localhost:1234",
        "timeout": 120,
        "context_size": 0
    },

    "llamacpp": {
        "url": "http://localhost:8080",
        "timeout": 120,
        "context_size": 0
    }
}
