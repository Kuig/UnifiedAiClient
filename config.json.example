{
    "_comment": "Copy this file to config.json and adjust values as needed. All sections and keys are optional — omitted keys fall back to these defaults.",

    "ollama": {
        "url": "http://localhost:11434",
        "timeout": 120,
        "keep_alive": "15m",
        "context_size": 0
    },

    "google": {
        "sleep_time": 3,
        "disable_safety": false,
        "timeout": 30,
        "upload_poll_timeout": 15
    },

