        "timeout": 120,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "anthropic": {
        "url": "https://api.anthropic.com",
        "timeout": 120,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "lmstudio": {
        "url": "http://localhost:1234",
        "timeout": 120,
        "context_size": 0
    },

    "llamacpp": {
        "url": "http://localhost:8080",
        "timeout": 120,
