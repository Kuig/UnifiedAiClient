{
    "_comment": "Shape reference with example values, not the built-in defaults: every key is optional and docs/configuration.md lists the real defaults. The preferred way to configure providers is configure_provider() in code (see README); this file is still read as a fallback if configure_provider() was never called for a given provider. Keys: 'url', 'timeout', 'sleep_time' map to ProviderConfig fields; all other keys are collected into extra_options and forwarded as provider-specific settings (e.g. context_size to num_ctx in Ollama, max_tokens to num_predict/max_output_tokens). Note that an explicit url also disables the missing-API-key check, being read as a proxy or gateway.",

    "ollama": {
        "url": "http://localhost:11434",
        "timeout": 300
    },

    "google": {
        "sleep_time": 3,
        "disable_safety": false,
        "timeout": 30,
        "upload_poll_timeout": 15
    },

    "openai": {
        "url": "https://api.openai.com",
        "timeout": 300,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "anthropic": {
        "url": "https://api.anthropic.com",
        "timeout": 300,
        "sleep_time": 1,
        "max_tokens": 8192
    },

    "lmstudio": {
        "url": "http://localhost:1234",
        "timeout": 300
    },

    "llamacpp": {
        "url": "http://localhost:8080",
        "timeout": 300
    },

    "mistral": {
        "url": "https://api.mistral.ai",
        "timeout": 300,
        "sleep_time": 0
    },

    "cohere": {
        "url": "https://api.cohere.ai/compatibility",
        "timeout": 300,
        "sleep_time": 0
    },

    "meta": {
        "url": "https://api.meta.ai",
        "timeout": 300,
        "sleep_time": 0
    },

    "groq": {
        "url": "https://api.groq.com/openai",
        "timeout": 300,
        "sleep_time": 0
    },

    "xai": {
        "url": "https://api.x.ai",
        "timeout": 300,
        "sleep_time": 0
    }
}
